# Northline Job Board - Environment Variables

# Authentication (set to "true" to enable Better Auth)
VITE_AUTH_ENABLED=false

# Database URL (for production/remote database)
# DATABASE_URL=postgresql://user:password@host:port/database

# Development
NODE_ENV=development

# Optional: Better Auth Configuration (if auth is enabled)
# BETTER_AUTH_SECRET=your-secret-key-here
# BETTER_AUTH_URL=http://localhost:5173

# Optional: OAuth Providers (if using Better Auth)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
